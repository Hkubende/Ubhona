PORT=8787
NODE_ENV=production

# Backend public URL (API host)
APP_BASE_URL=https://api.ubhona.com
# Public frontend base URL for links/redirects (order tracking, QR deep links)
FRONTEND_URL=https://app.ubhona.com
# Backward-compatible alias used by messaging services
APP_PUBLIC_BASE_URL=https://app.ubhona.com
# Optional alias for QR/public links
QR_BASE_URL=https://app.ubhona.com
PUBLIC_APP_URL=https://app.ubhona.com

DATABASE_URL=postgresql://user:pass@localhost:5432/menuvista
JWT_SECRET=change-this-secret
ORDER_TRACKING_SECRET=change-this-order-tracking-secret

# Comma-separated frontend origins, or * during development
CORS_ORIGIN=*

# sandbox | production
MPESA_ENV=sandbox

# Safaricom Daraja credentials
MPESA_CONSUMER_KEY=your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-mpesa-passkey
MPESA_CALLBACK_URL=https://api-staging.ubhona.com/payments/callback
MPESA_CALLBACK_SECRET=change-this-callback-secret
# Optional timeout callback URL (provider/infra dependent)
MPESA_TIMEOUT_URL=https://api-staging.ubhona.com/payments/timeout
# Usually CustomerPayBillOnline for paybill, or CustomerBuyGoodsOnline for till
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Optional override; defaults to MPESA_SHORTCODE
MPESA_PARTY_B=

# Billing foundation
# Used by /billing/webhooks/:provider endpoint.
BILLING_WEBHOOK_SECRET=change-this-billing-webhook-secret
# Default provider for upgrades/payments when not explicitly passed.
BILLING_DEFAULT_PROVIDER=manual
# mock | live
BILLING_MPESA_MODE=mock

# Supabase Storage (for image and GLB uploads)
SUPABASE_URL=https://your-project.supabase.co
# Backend-safe secret key (never expose in frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional for backend integrations that require anon context
SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional legacy fallback bucket used when per-asset buckets are not set.
SUPABASE_STORAGE_BUCKET=
# Recommended per-asset buckets
SUPABASE_STORAGE_BUCKET_THUMBNAILS=dish-thumbnails
SUPABASE_STORAGE_BUCKET_MODELS=dish-models
SUPABASE_STORAGE_BUCKET_BRANDING=restaurant-branding
# Optional explicit public base URL. Default: {SUPABASE_URL}/storage/v1/object/public
SUPABASE_STORAGE_PUBLIC_URL=

# WhatsApp notifications
# mock | meta_cloud | twilio
WHATSAPP_PROVIDER=mock

# Meta WhatsApp Cloud API (preferred names)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Backward-compatible aliases still supported by some services
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Template names (must match approved provider templates)
WHATSAPP_TEMPLATE_ORDER_PLACED=ubhona_order_placed
WHATSAPP_TEMPLATE_ORDER_CONFIRMED=ubhona_order_confirmed
WHATSAPP_TEMPLATE_ORDER_PREPARING=ubhona_order_preparing
WHATSAPP_TEMPLATE_ORDER_READY=ubhona_order_ready
WHATSAPP_TEMPLATE_ORDER_COMPLETED=ubhona_order_completed
WHATSAPP_TEMPLATE_DIRECTOR_THANK_YOU=ubhona_director_thank_you
