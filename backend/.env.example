NODE_ENV=production


APP_BASE_URL=https://api.ubhona.com
FRONTEND_URL=https://app.ubhona.com
APP_PUBLIC_BASE_URL=https://app.ubhona.com
QR_BASE_URL=https://app.ubhona.com
PUBLIC_APP_URL=https://app.ubhona.com


APP_RUNTIME_DATABASE_URL=postgresql://postgres.zezoynocccvxggyouxpd:EGe1lhjTZkbnaaGi@aws-1-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.zezoynocccvxggyouxpd:EGe1lhjTZkbnaaGi@aws-1-eu-central-1.pooler.supabase.com:5432/postgres


# Legacy diagnostic override only. Leave empty for standard rollout validation.
RLS_VALIDATE_DATABASE_URL=

# Optional explicit apply-role override for rollout SQL.
RLS_APPLY_DATABASE_URL=
JWT_SECRET=replace-with-a-strong-32-plus-character-secret
PAYMENT_PROFILE_ENCRYPTION_KEY=replace-with-a-strong-32-plus-character-secret

ORDER_TRACKING_SECRET=change-this-order-tracking-secret

# Comma-separated frontend origins, or * during development
CORS_ORIGIN=*

# sandbox | production
MPESA_ENV=sandbox

# Safaricom Daraja credentials
MPESA_CONSUMER_KEY=your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-mpesa-passkey
MPESA_CALLBACK_URL=https://api-staging.ubhona.com/payments/callback
MPESA_CALLBACK_SECRET=change-this-callback-secret
# Optional timeout callback URL (provider/infra dependent)
MPESA_TIMEOUT_URL=https://api-staging.ubhona.com/payments/timeout
# Usually CustomerPayBillOnline for paybill, or CustomerBuyGoodsOnline for till
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Optional override; defaults to MPESA_SHORTCODE
MPESA_PARTY_B=

# Billing foundation
# Used by /billing/webhooks/:provider endpoint.
BILLING_WEBHOOK_SECRET=change-this-billing-webhook-secret
# Default provider for upgrades/payments when not explicitly passed.
BILLING_DEFAULT_PROVIDER=manual
# mock | live
BILLING_MPESA_MODE=mock


