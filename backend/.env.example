PORT=4000
NODE_ENV=production


APP_BASE_URL=https://ubhona-api.onrender.com
FRONTEND_URL=https://ubhona.onrender.com
APP_PUBLIC_BASE_URL=https://ubhona.onrender.com
QR_BASE_URL=https://ubhona.onrender.com
PUBLIC_APP_URL=https://ubhona.onrender.com


APP_RUNTIME_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres


# Legacy diagnostic override only. Leave empty for standard rollout validation.
RLS_VALIDATE_DATABASE_URL=

# Optional explicit apply-role override for rollout SQL.
RLS_APPLY_DATABASE_URL=
JWT_SECRET=replace-with-a-strong-32-plus-character-secret
PAYMENT_PROFILE_ENCRYPTION_KEY=replace-with-a-strong-32-plus-character-secret

ORDER_TRACKING_SECRET=change-this-order-tracking-secret

# Comma-separated frontend origins, or * during development
CORS_ORIGIN=https://ubhona.onrender.com

# sandbox | production
MPESA_ENV=sandbox

# Safaricom Daraja credentials
MPESA_CONSUMER_KEY=your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-mpesa-passkey
MPESA_CALLBACK_URL=https://ubhona-api.onrender.com/payments/callback
MPESA_CALLBACK_SECRET=change-this-callback-secret
# Optional timeout callback URL (provider/infra dependent)
MPESA_TIMEOUT_URL=https://ubhona-api.onrender.com/payments/timeout
# Usually CustomerPayBillOnline for paybill, or CustomerBuyGoodsOnline for till
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Optional override; defaults to MPESA_SHORTCODE
MPESA_PARTY_B=

# Billing foundation
# Used by /billing/webhooks/:provider endpoint.
BILLING_WEBHOOK_SECRET=change-this-billing-webhook-secret
# Default provider for upgrades/payments when not explicitly passed.
BILLING_DEFAULT_PROVIDER=manual
# mock | live
BILLING_MPESA_MODE=mock


SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_BUCKET_THUMBNAILS=dish-thumbnails
SUPABASE_STORAGE_BUCKET_MODELS=dish-models
SUPABASE_STORAGE_BUCKET_BRANDING=restaurant-branding
SUPABASE_STORAGE_PUBLIC_URL=https://<project-ref>.supabase.co/storage/v1/object/public

# WhatsApp notifications
# mock | meta_cloud | twilio
WHATSAPP_PROVIDER=mock

# Meta WhatsApp Cloud API (preferred names)
WHATSAPP_ACCESS_TOKEN=replace-with-meta-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-meta-whatsapp-phone-number-id
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Backward-compatible aliases still supported by some services
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=


# Template names (must match approved provider templates)
WHATSAPP_TEMPLATE_ORDER_PLACED=ubhona_order_placed
WHATSAPP_TEMPLATE_ORDER_CONFIRMED=ubhona_order_confirmed
WHATSAPP_TEMPLATE_ORDER_PREPARING=ubhona_order_preparing
WHATSAPP_TEMPLATE_ORDER_READY=ubhona_order_ready
WHATSAPP_TEMPLATE_ORDER_COMPLETED=ubhona_order_completed
WHATSAPP_TEMPLATE_DIRECTOR_THANK_YOU=ubhona_director_thank_you
