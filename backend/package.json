{
  "name": "menuvista-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate --schema src/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema src/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema src/prisma/schema.prisma",
    "rls:audit:apply": "node scripts/rls-role-audit.mjs --mode=apply",
    "rls:audit:validate": "node scripts/rls-role-audit.mjs --mode=validate",
    "rls:preflight": "node scripts/rls-rollout.mjs preflight",
    "rls:apply": "node scripts/rls-rollout.mjs apply",
    "rls:validate": "node scripts/rls-rollout.mjs validate",
    "rls:validate:backend": "npm run build && node scripts/rls-backend-contract.mjs",
    "rls:validate:callback": "npm run build && node scripts/rls-payment-callback-validate.mjs",
    "rls:validate:full": "npm run rls:validate && npm run rls:validate:backend"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "@supabase/supabase-js": "^2.49.8",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "google-auth-library": "^10.6.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "pg": "^8.20.0",
    "redis": "^5.12.1",
    "sharp": "^0.34.4",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.21",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.7.0",
    "supertest": "^7.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  }
}
