VITE_BASE_PATH=/
# Frontend API base (required for real backend mode).
# Example local backend: http://localhost:4000
VITE_API_BASE=
# Optional STK/M-Pesa endpoint if separate from VITE_API_BASE.
VITE_STK_API_BASE=
# Canonical public frontend URL used for QR/share links.
# Example: https://app-staging.ubhona.com
VITE_PUBLIC_APP_URL=

# Supabase Storage (frontend direct uploads)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Upload provider mode: auto | api | supabase
# For Ubhona production use: api
VITE_UPLOAD_PROVIDER=api

# Dev-only API diagnostics in browser console.
VITE_LOG_API_INFO=false

VITE_APP_NAME=Ubhona
VITE_APP_SLOGAN=Visualize
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ORDERS=false
