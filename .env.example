VITE_BASE_PATH=/
# Frontend API base (required for real backend mode).
# Example production backend on Render: https://your-render-backend.onrender.com
VITE_API_BASE=https://your-render-backend.onrender.com
# Optional STK/M-Pesa endpoint if separate from VITE_API_BASE.
# Use the same backend host unless STK is served separately.
VITE_STK_API_BASE=https://your-render-backend.onrender.com
# Google Identity Services web client ID for Sign in with Google.
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Canonical public frontend URL used for QR/share links.
# Example: https://app-staging.ubhona.com
VITE_PUBLIC_APP_URL=
# Canonical site URL used for SEO metadata/canonical tags.
# Example: https://app-staging.ubhona.com
VITE_SITE_URL=

# Supabase Storage (frontend direct uploads)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Upload provider mode: auto | api | supabase
# For Ubhona production use: api
VITE_UPLOAD_PROVIDER=api

# Dev-only API diagnostics in browser console.
VITE_LOG_API_INFO=false

VITE_APP_NAME=Ubhona
VITE_APP_SLOGAN=Visualize
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ORDERS=false

# Backend Redis URL for live order event fanout.
# Optional locally; required in production when using Redis-backed order events.
REDIS_URL=redis://default:password@host:6379
